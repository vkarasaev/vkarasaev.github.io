---
// /principles/: главное о работе, анкета после первой сессии и подробные договоренности.
// Стоимость, формат, контакты и ссылка на анкету - только из site.ts.
import Page from '../../layouts/Page.astro';
import { site } from '../../data/site';

const principles = [
  {
    number: '01',
    title: 'Формат сессий',
    text: `Сессия длится ${site.session.durationShort} и проходит онлайн или очно. Обычно мы встречаемся раз в неделю. Онлайн - с камерой, очно - ${site.session.offline}.`,
  },
  {
    number: '02',
    title: 'Отмены и переносы',
    text: 'Отмена или перенос без оплаты - возможны за 24 часа. Позже - сессия оплачивается независимо от причины. При опоздании я жду вас 15 минут.',
  },
  {
    number: '03',
    title: 'Оплата',
    text: `Сессия стоит ${site.session.priceRub} или ${site.session.priceEur}. Оплата - в день встречи, до нее или сразу после. Об оплатах я не напоминаю.`,
  },
  {
    number: '04',
    title: 'Конфиденциальность',
    text: 'Все, что происходит на сессиях, остается между нами. Исключений два - профессиональная супервизия без личных данных и прямая угроза жизни.',
  },
  {
    number: '05',
    title: 'Границы',
    text: 'Я не провожу терапию в переписке и не вступаю с клиентами в личные отношения. Все важное, включая чуства ко мне, лучше принести на сессию.',
  },
  {
    number: '06',
    title: 'Завершение',
    text: 'Терапию можно завершить в любой момент. При этом лучше не исчезать, а выделить несколько сессий на завершение: часто это оказывается важным.',
  },
  {
    number: '07',
    title: 'На встрече можно',
    text: 'Плакать и смеяться. Ругаться матом. Злиться - в том числе на меня. Говорить о сексе, деньгах и зависти. Молчать, если слов пока нет. Быть уязвимым, растерянным или уставшим - здесь не нужно быть удобным.',
  },
];

type Agreement = {
  number: string;
  title: string;
  lead: string;
  paragraphs: string[];
  listFrom?: number;
  listTo?: number;
  link?: {
    intro: string;
    href: string;
    label: string;
  };
};

const agreements: Agreement[] = [
  {
    number: '01',
    title: 'Продолжительность и формат сессий',
    lead: 'Длительность, платформы и место очных встреч.',
    paragraphs: [
      `Стандартная сессия длится ${site.session.durationShort}. Иногда для работы нужно больше непрерывного времени. По предварительной договоренности можно провести расширенную сессию: ${site.session.extended[0].duration} - ${site.session.extended[0].priceRub}, ${site.session.extended[1].duration} - ${site.session.extended[1].priceRub}.`,
      `Сессии проходят онлайн в ${site.session.platformsProse} либо очно: ${site.session.offline}. У каждого формата есть свои плюсы и минусы, - онлайн выше гибкость, очно - интенсивность.`,
    ],
    link: {
      intro: 'Адрес и схема проезда есть на странице',
      href: '/contact/',
      label: '«Контакты».',
    },
  },
  {
    number: '02',
    title: 'Частота и сроки терапии',
    lead: 'Как часто мы встречаемся и сколько может продолжаться работа.',
    paragraphs: [
      'Обычно мы встречаемся раз в неделю. В период острого кризиса иногда полезно встречаться дважды в неделю. Ближе к завершению или в поддерживающем формате можно перейти на встречи раз в две недели.',
      'Сроки зависят от глубины запроса и от того, каких изменений вы хотите. Работа с конкретной и ограниченной задачей может занять от 5 до 10 сессий, работа с острым кризисом - от 10 до 20. Если запрос связан с устойчивыми паттернами, отношениями и привычным способом жить, терапия может продолжаться от полугода до нескольких лет.',
    ],
    link: {
      intro: 'Подробнее -',
      href: '/blog/terapiya-06-skolko-dlitsya-terapiya/',
      label: '«Сколько может длиться терапия».',
    },
  },
  {
    number: '03',
    title: 'Стоимость и порядок оплаты',
    lead: 'Стоимость, способы оплаты и правила ее изменения.',
    paragraphs: [
      `Стандартная сессия стоит ${site.session.priceRub} или ${site.session.priceEur}. Оплатить встречу можно в день сессии, до нее или сразу после.`,
      'Про оплату я не напоминаю.',
      'Оплачивать можно по одной встрече или блоком из 4-5 сессий. Блок закрепляет регулярное время на оплаченный период, но не дает скидки.',
      `Оплата возможна ${site.session.paymentMethodsLong}. Реквизиты я пришлю после первой сессии.`,
      `Стоимость фиксируется минимум на ${site.session.priceReview.minimumPeriod}. Затем она может меняться не чаще раза в год и не более чем на ${site.session.priceReview.maximumAnnualIncrease}. Об изменении я предупреждаю заранее.`,
    ],
  },
  {
    number: '04',
    title: 'Отмены, переносы и опоздания',
    lead: 'Что происходит при отмене, переносе или опоздании.',
    paragraphs: [
      'Отменить или перенести встречу без оплаты можно не позднее чем за 24 часа. Если вы предупреждаете позже, сессия оплачивается полностью независимо от причины отмены.',
      'Если вы опаздываете, встреча все равно заканчивается в запланированное время. Если через 15 минут после начала сессии от вас нет сообщения, я считаю встречу пропущенной и больше не жду. Такая сессия оплачивается полностью.',
      'Если опаздываю я, мы продлеваем встречу на потерянное время в этот или в другой день.',
    ],
  },
  {
    number: '05',
    title: 'Конфиденциальность',
    lead: 'Что остается между нами и в каких случаях возможны исключения.',
    paragraphs: [
      'Все, что происходит на сессии, конфиденциально. При этом есть два исключения.',
      'Я могу обсуждать нашу работу с супервизором. Это стандартная профессиональная практика, которая помогает мне лучше работать с вами. Ваше имя и сведения, по которым вас можно узнать, не раскрываются.',
      'Если я сочту вероятной непосредственную угрозу вашей жизни или жизни другого человека, я могу обратиться за дополнительной помощью. Насколько возможно, сначала я обсужу это с вами.',
    ],
  },
  {
    number: '06',
    title: 'Связь между сессиями',
    lead: 'Когда можно написать и где проходит граница между сообщением и терапией.',
    paragraphs: [
      'Между сессиями мне можно писать в Telegram. Там можно решить организационный вопрос, предупредить об отмене или поделиться важной новостью.',
      'При этом терапию в переписке я не провожу и в длительных обсуждениях в чате предпочитаю не участвовать. Если сообщение требует подробного разговора, - лучше мы вернемся к нему на сессии.',
    ],
  },
  {
    number: '07',
    title: 'Условия для работы онлайн',
    lead: 'Что нужно для полноценной онлайн-сессии.',
    paragraphs: [
      'Для полноценной онлайн-сессии важно заранее подготовить несколько вещей.',
      '1) Уединенное пространство, где вас не будут слышать, прерывать или отвлекать. Если есть возможность, лучше выбрать место, где вы можете быть наедине хотя бы 1,5 часа. Примечание: святой любящий муж или жена за дверью, любознательные коллеги проходящие мимо переговорки, забегающий ребенок, собака залезающая на голову, и даже соседка с перфоратором - все это может помешать говорить свободно.',
      '2) Стабильное интернет-соединение на протяжении всей встречи. Если есть сомнения, лучше заранее проверить скорость и стабильность соединения.',
      '3) Включенная камера. Онлайн-сессии проходят с видео.',
      '4) Наушники или заранее проверенный звук без эха и помех.',
      '5) Беззвучный режим на телефоне и отключенные уведомления.',
      '6) Телефон нужно зарядить и удобно закрепить, чтобы не держать в руках.',
      '7) Если какое-то из этих условий трудно обеспечить, предупредите меня заранее: обсудим, как лучше провести встречу.',
    ],
    listFrom: 1,
    listTo: 5,
  },
  {
    number: '08',
    title: 'Пауза и завершение работы',
    lead: 'Как сделать паузу или закончить терапию.',
    paragraphs: [
      'Терапию можно поставить на паузу или завершить в любой момент. В том числе - это можно сделать резко и без лишних объяснений. В том числе - потом можно вернуться к работе, если возникнет желание и будут места.',
      'При этом я все-таки предлагаю не исчезать резко, а набраться храбрости и попробовать обсудить причины, побуждающие вас завершить работу. Особенно важно дать этому место, если решение связано с сильной эмоциональной реакцией.',
      'Часто возможность прямого диалога вместо разрыва контакта оказывается тем самым опытом отношений другого качества.',
    ],
    link: {
      intro: 'Подробнее -',
      href: '/blog/otnosheniya-05-ostatsya-pauza-uyti/',
      label: '«Продолжать терапию, сделать паузу или уйти?»',
    },
  },
  {
    number: '09',
    title: 'Цели и результат терапии',
    lead: 'Как мы определяем направление работы и замечаем изменения.',
    paragraphs: [
      'Терапия - это не бесцельный разговор. Но это и не "мероприятие по починке сломанного человека". Цели важны и важна их экологичность и реалистичность.',
      'Но это совершенно не означает, что вы должны абсолютно точно знать, чего хотите. Это бывает редко. Можно прийти без точной формулировки: и тогда первой нашей задачей будет разобраться, что происходит и чего вы хотите изменить.',
      'По ходу терапии цели могут уточняться. Время от времени мы сверяемся, что уже изменилось, а что остается трудным. И также мы обсуждаем, помогает ли выбранный формат двигаться дальше.',
    ],
    link: {
      intro: 'Подробнее -',
      href: '/blog/terapiya-05-kak-ponyat-chto-terapiya-rabotaet/',
      label: '«Как понять, что терапия работает».',
    },
  },
];
---

<Page
  title="Принципы и договоренности · Валерий Карасаев"
  description="Главное о формате и атмосфере встреч, подробные договоренности и анкета для клиентов после первой сессии."
  translation="/en/principles/"
  hideCta={true}
>
  <header class="page-head principles-head">
    <div class="kicker">Принципы и договоренности</div>
    <h1 class="page-title">Как устроена наша работа</h1>
    <p class="lead">
      Сначала главное о формате и атмосфере встреч. А ниже - подробные договоренности,
      к которым можно вернуться в любой момент.
    </p>
    <button class="rules-print" type="button">Скачать PDF</button>
  </header>

  <section id="principles" class="principles-section page-section" aria-labelledby="principles-title">
    <header class="section-head">
      <h2 id="principles-title">Главное о работе</h2>
      <p>Семь основных вещей, которые стоит знать о формате и атмосфере встреч.</p>
    </header>

    <ol class="principles-grid">
      {principles.map((principle) => (
        <li class:list={{ "principle-warm": principle.number === '07' }}>
          <span class="principle-number">{principle.number}</span>
          <h3>{principle.title}</h3>
          <p>{principle.text}</p>
        </li>
      ))}
    </ol>

    <p class="prospect-next">
      Если мы еще не знакомы, можно посмотреть, <a href="/therapy/">как проходит терапия</a>,
      или <a href={site.telegramSession}>записаться на первую сессию</a>. Если уже работаем,
      ниже можно открыть подробные договоренности.
    </p>
  </section>

  <section class="agreements-section page-section" id="agreements" aria-labelledby="agreements-title">
    <header class="section-head">
      <h2 id="agreements-title">Подробные договоренности</h2>
      <p>Здесь собраны подробности о встречах, оплате, связи между сессиями и завершении работы.</p>
    </header>

    <div class="agreements-paper">
      <div class="agreement-list">
        {agreements.map((agreement) => (
          <details>
            <summary>
              <span class="agreement-summary">
                <strong>{agreement.title}</strong>
                <small>{agreement.lead}</small>
              </span>
            </summary>
            <div class="agreement-body">
              {agreement.paragraphs.map((paragraph, index) => (
                agreement.listFrom !== undefined && agreement.listTo !== undefined && index >= agreement.listFrom && index <= agreement.listTo ? (
                  index === agreement.listFrom ? (
                    <ul>
                      {agreement.paragraphs.slice(agreement.listFrom, agreement.listTo + 1).map((item) => <li>{item}</li>)}
                    </ul>
                  ) : null
                ) : <p>{paragraph}</p>
              ))}
              {agreement.link && (
                <p>
                  {agreement.link.intro} <a href={agreement.link.href}>{agreement.link.label}</a>
                </p>
              )}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="intake-section page-section" id="intake" aria-labelledby="intake-title">
    <span class="anchor-alias" id="after-session" aria-hidden="true"></span>
    <header class="section-head">
      <h2 id="intake-title">Анкета клиента</h2>
      <p>Если после первой встречи мы решили продолжить работу, заполните анкету до следующей сессии.</p>
    </header>

    <div class="intake-card">
      <div>
        <span class="intake-tag">Google Forms</span>
        <p>Контакты, вопросы о состоянии и предыдущем опыте.</p>
      </div>
      <a class="intake-action" href={site.intakeForm} target="_blank" rel="noopener noreferrer nofollow">
        Открыть анкету
      </a>
    </div>
  </section>

  <div class="closing-note">
    <h2>Не все можно предусмотреть заранее</h2>
    <p>
      Если что-то непонятно, не подходит или вызывает вопросы, мы можем обсудить это на сессии.
      По организационным вопросам можно <a href={site.telegram}>написать мне в Telegram</a>.
    </p>
  </div>
</Page>

<script is:inline>
  const printButton = document.querySelector('.rules-print');

  printButton?.addEventListener('click', () => {
    const details = Array.from(document.querySelectorAll('.agreement-list details'));
    const openState = details.map((item) => item.open);

    details.forEach((item) => {
      item.open = true;
    });

    const restore = () => {
      details.forEach((item, index) => {
        item.open = openState[index];
      });
      window.removeEventListener('afterprint', restore);
    };

    window.addEventListener('afterprint', restore);
    window.print();
  });
</script>

<style>
