    </a>
  </div>


  <div class="sep"><div class="sep-line"></div><div class="sep-dot"></div><div class="sep-line"></div></div>

  <!-- ══ ДРУГИЕ ФОРМАТЫ ══ -->
  <div class="section">
    <div class="section-label">Другие форматы</div>
    <div class="links-list">
      <a href="/groups/" class="link-btn"><span class="link-title">Терапевтические группы</span><span class="link-arrow">→</span></a>
