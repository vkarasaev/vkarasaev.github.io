---
// Базовый layout: head, мета, OG, canonical, hreflang.
// Стили страниц подключаются через слот или import в самой странице.
// Шрифты лежат на самом сайте (public/fonts, правила в styles/fonts.css), без Google Fonts.
import '../styles/fonts.css';

export interface Props {
  title: string;
  description: string;
  lang?: 'ru' | 'en';
  ogImage?: string;
  canonical?: string;
  translation?: string; // URL парной страницы на другом языке
  noindex?: boolean;
}

const {
  title,
  description,
  lang = 'ru',
  ogImage = '/images/og-karasaev.png',
  canonical,
  translation,
  noindex = false,
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL(ogImage, Astro.site).href;

// Шрифты первого экрана загружаются заранее, одновременно со стилями:
// так текст сразу рисуется нужным шрифтом, без скачка от запасного к основному.
// Пробел, цифры и знаки препинания живут в latin-файлах, поэтому русской странице нужны оба набора.
const preloadFonts =
  lang === 'ru'
    ? [
        'jost-cyrillic',
        'jost-latin',
        'cormorant-garamond-cyrillic',
        'cormorant-garamond-latin',
        'cormorant-garamond-italic-cyrillic',
        'cormorant-garamond-italic-latin',
      ]
    : ['jost-latin', 'cormorant-garamond-latin', 'cormorant-garamond-italic-latin'];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />
    {translation && (
      <link rel="alternate" hreflang={lang === 'ru' ? 'en' : 'ru'} href={new URL(translation, Astro.site).href} />
    )}
    {translation && <link rel="alternate" hreflang={lang} href={canonicalURL} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    {preloadFonts.map((name) => (
      <link rel="preload" href={`/fonts/${name}.woff2`} as="font" type="font/woff2" crossorigin />
    ))}
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
