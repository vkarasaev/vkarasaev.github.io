---
// Версия 8 лендинга направления: сборка из блоков, выбранных Валерием 19.11.2026.
//   первый экран и условия: версии 4 и 5, чуть больше воздуха
//   вводный текст: версия 3, две колонки и строка с именем
//   «Возможно, это про вас», «Но что за этим…», «Как с этим работаю я»: схема версии 1,
//     заголовок слева, содержание справа; справа строки с плюсом из версии 4
//   «Почему эта тема мне близка»: версия 5
//   «С чего можно начать»: светлый блок версии 1, стоит в середине страницы
//   «Почитать по теме»: версия 7
//   «Более личное»: две карточки с маленькими личными картинками
//   конец страницы: общий блок сайта «Первый шаг - просто написать»
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';
import { site } from '../../data/site';
import { getBlogFormatLabel, getBlogHref, getBlogSlug } from '../../utils/blog';
import { plural, typograf } from '../../utils/typograf';
import '../../styles/direction-v8.css';

export interface Props {
  direction: any;
}
const { direction: d } = Astro.props;
const t = typograf;
const introMinutes = site.intro.minutes;

const headlineLines = d.hero.headlineLines ?? [d.hero.headline];
const price = `${site.session.priceRub} / ${site.session.priceEur}`;
const facts = [
  [site.session.durationShort, 'индивидуальная сессия'],
  [price, 'стоимость'],
  ['Онлайн', 'или очно в Москве'],
  [`${introMinutes} минут`, 'бесплатное знакомство'],
];
// Светлый блок «С чего можно начать», как в версии 1.
const startTerms = [
  ['Индивидуальная сессия', site.session.durationShort],
  ['Стоимость', price],
  ['Где', 'Онлайн или очно в Москве'],
  ['Как часто', 'Обычно раз в неделю; частоту обсуждаем вместе'],
];
const startNote = `Если сначала хочется познакомиться и задать вопросы о формате, можно договориться о бесплатной встрече на ${introMinutes} минут.`;

const workRows = [...(d.work.options ?? []), ...(d.work.after ?? [])];
const gold = (text: string) => t(text).replace(/^((?:А\s|А&nbsp;|А )?[Ии]ногда)/, '<span class="dv-gold">$1</span>');

const posts = await getCollection('blog', ({ data }) => !data.draft && data.lang === 'ru');
const bySlug = new Map(posts.map((post) => [getBlogSlug(post), post]));
const series = d.materials?.series ? bySlug.get(d.materials.series) : undefined;
const partSlugs = series
  ? [...new Set([...(series.body ?? '').matchAll(/\]\(\/blog\/([^)\s/]+)\/\)/g)].map((m) => m[1]))]
  : [];
const parts = partSlugs.map((slug) => bySlug.get(slug)).filter((post) => post !== undefined);
const half = Math.ceil(parts.length / 2);
const articles = (d.materials?.articles ?? []).map((slug: string) => bySlug.get(slug)).filter((post: unknown) => post !== undefined);
const pad = (n: number) => String(n).padStart(2, '0');
const personalChannel = site.channels[0]?.label ?? 'Telegram';
---

<Page title={d.meta.title} description={d.meta.description} noindex={true} wide={true}>
  <article class="dv v8">
    <header class="dv-hero">
      <img class="dv-hero-photo" src={d.hero.photo.src} alt={d.hero.photo.alt} width="1536" height="1024" />
      <div class="dv-hero-copy dv-rise">
        <p class="dv-meta">{d.topic}</p>
        <h1 class="dv-display">
          {headlineLines.map((line: string) => <><span set:html={t(line)} />{' '}</>)}
        </h1>
        {d.hero.sub && <p class="dv-text dv-sub" set:html={t(d.hero.sub)} />}
        <div class="dv-hero-cta">
          <a class="dv-btn" href={site.telegram}>{d.hero.cta}</a>
          <p class="dv-who">{site.name} · психолог, гештальт-терапевт</p>
        </div>
      </div>
    </header>

    <dl class="dv-facts" aria-label="Условия">
      {facts.map(([value, label]) => (<div><dt set:html={t(value)} /><dd>{label}</dd></div>))}
    </dl>

    <div class="v8-intro">
      <p class="dv-item v8-intro-who">{site.name} · психолог, гештальт-терапевт. Индивидуальная работа онлайн и очно в Москве.</p>
      <p class="v8-intro-p" set:html={t(d.hero.lead[0])} />
      <p class="v8-intro-p" set:html={t(d.hero.lead[1])} />
    </div>

    <section class="dv-band v8-sec" id="situations" aria-labelledby="situations-title">
      <div class="v8-rail">
        <h2 class="dv-h2" id="situations-title" set:html={t(d.recognition.title)} />
        <ul class="v8-recognition">
          {d.recognition.items.map((item: string) => <li><p set:html={t(item)} /></li>)}
        </ul>
      </div>
    </section>

    <section class="dv-sec v8-sec" id="questions" aria-labelledby="questions-title">
      <div class="v8-rail">
        <h2 class="dv-h2" id="questions-title" set:html={t(d.insight.title)} />
        <div class="dv-acc">
          {d.insight.rows.map((row: any) => (
            <details class="dv-row">
              <summary><h3 class="dv-item" set:html={t(row.title)} /></summary>
              <div class="dv-row-body">
                {row.blocks.map((b: any) =>
                  b.type === 'p' ? (
                    <p class="dv-text" set:html={t(b.html)} />
                  ) : b.type === 'questions' ? (
                    <ul class="dv-voices">
                      {b.items.map((q: string) => (<li class="dv-panel"><p class="dv-voice" set:html={t(q)} /></li>))}
                    </ul>
                  ) : (
                    <dl class="dv-defs">
                      {b.items.map((c: any) => (
                        <div class="dv-panel">
                          <dt class="dv-item" set:html={t(c.term)} />
                          <dd class="dv-text" set:html={t(c.text)} />
                        </div>
                      ))}
                    </dl>
                  ),
                )}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="dv-band v8-sec" id="approach" aria-labelledby="approach-title">
      <div class="v8-rail">
        <h2 class="dv-h2" id="approach-title" set:html={t(d.work.title)} />
        <div>
          <div class="dv-prose">
            {d.work.paragraphs.map((p: string) => <p class="dv-text" set:html={t(p)} />)}
          </div>
          {workRows.length > 0 && (
            <ul class="v8-sometimes">
              {workRows.map((o: string) => (<li><p class="dv-text" set:html={gold(o)} /></li>))}
            </ul>
          )}
        </div>
      </div>
      {d.work.thesis && <p class="dv-h2 v8-quote" set:html={t(d.work.thesis)} />}
    </section>

    <section class="dv-sec v8-sec" id="author" aria-labelledby="author-title">
      <h2 class="dv-h2" id="author-title" set:html={t(d.author.title)} />
      <div class="dv-duo">
        {d.author.photo && (
          <div class="dv-duo-photo dv-photo-calm">
            <img src={d.author.photo.src} alt={d.author.photo.alt} width="1536" height="1024" loading="lazy" style={d.author.photo.position ? `object-position: ${d.author.photo.position}` : undefined} />
          </div>
        )}
        <div class="dv-duo-text">
          <div class="dv-prose">
            {d.author.paragraphs.map((p: string) => <p class="dv-text" set:html={t(p)} />)}
          </div>
          <p class="dv-links">
            <a class="dv-link" href="/about/">Обо мне</a>
            <a class="dv-link" href="/business/">Опыт в бизнесе</a>
            <a class="dv-link" href="/credentials/">Образование</a>
          </p>
        </div>
      </div>
    </section>

    <section class="dv-sec v8-sec" id="start" aria-label={d.start.title}>
      <div class="v8-start">
        <div class="v8-start-main">
          <h2 class="v8-start-title" set:html={t(d.start.title)} />
          <p set:html={t(d.startIntro)} />
          <div class="v8-start-actions">
            <a class="v8-btn-ink" href={site.telegram}>{d.start.cta}</a>
            <a class="v8-link-ink" href="/therapy/">
              Подробнее о терапии
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3 8h9.5M8.5 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </a>
          </div>
        </div>
        <div class="v8-start-terms">
          <dl class="v8-terms">
            {startTerms.map(([key, value]) => (
              <div class="v8-terms-row"><dt>{key}</dt><dd set:html={t(value)} /></div>
            ))}
          </dl>
          <p class="v8-terms-note" set:html={t(startNote)} />
        </div>
      </div>
    </section>

    {d.materials && (series || articles.length > 0) && (
      <section class="dv-band" id="reading" aria-labelledby="reading-title">
        <h2 class="dv-h2" id="reading-title" set:html={t(d.materials.title)} />
        {series && (
          <>
            <div class="dv-series">
              <a class="dv-series-cover" href={getBlogHref(series)} tabindex="-1" aria-hidden="true">
                {series.data.cover && <img src={series.data.cover} alt="" width="988" height="659" loading="lazy" />}
              </a>
              <div class="dv-series-text">
                <p class="dv-meta">Цикл{parts.length > 0 && `, ${parts.length} ${plural(parts.length, ['статья', 'статьи', 'статей'])}`}</p>
                <h3 class="dv-item"><a class="dv-title-link" href={getBlogHref(series)} set:html={t(series.data.title.replace(/^Цикл\s+/, ''))} /></h3>
                <p class="dv-text" set:html={t(series.data.description)} />
              </div>
            </div>
            {parts.length > 0 && (
              <div class="dv-parts">
                <ol>
                  {parts.slice(0, half).map((part: any, i: number) => (
                    <li><a href={getBlogHref(part)}><span class="dv-meta" aria-hidden="true">{pad(i + 1)}</span><span set:html={t(part.data.title)} /></a></li>
                  ))}
                </ol>
                <ol start={half + 1}>
                  {parts.slice(half).map((part: any, i: number) => (
                    <li><a href={getBlogHref(part)}><span class="dv-meta" aria-hidden="true">{pad(half + i + 1)}</span><span set:html={t(part.data.title)} /></a></li>
                  ))}
                </ol>
              </div>
            )}
          </>
        )}
        {articles.length > 0 && (
          <ul class="dv-articles">
            {articles.map((post: any) => (
              <li>
                <a class="dv-article dv-panel" href={getBlogHref(post)}>
                  {post.data.cover && <img src={post.data.cover} alt="" width="482" height="271" loading="lazy" />}
                  <span class="dv-article-text">
                    <span class="dv-meta">{getBlogFormatLabel(post.data.format)}</span>
                    <span class="dv-item" set:html={t(post.data.title)} />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>
    )}

    {d.personal && (
      <section class="dv-sec v8-sec" id="personal" aria-labelledby="personal-title">
        <h2 class="dv-h2" id="personal-title" set:html={t(d.personal.title)} />
        <p class="dv-text v8-personal-intro" set:html={t(d.personal.intro)} />
        <ul class="v8-personal">
          {d.personal.items.map((item: any) => (
            <li>
              <a class="dv-panel" href={item.href} target="_blank" rel="noopener">
                {item.thumb && <img src={item.thumb} alt="" width="96" height="96" loading="lazy" />}
                <span class="v8-personal-text">
                  <span class="dv-meta">{personalChannel}</span>
                  <span class="dv-item" set:html={t(item.title)} />
                  <span class="dv-text" set:html={t(item.note)} />
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</Page>
