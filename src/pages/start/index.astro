    <p style="text-align: center; font-size: 13.5px; margin: 14px 0 0;">
      <a href="/therapy/" style="color: var(--gold); text-decoration: none;">Как проходит терапия</a>
      <span style="color: #6a665e;"> · </span>
      <a href="/principles/" style="color: var(--gold); text-decoration: none;">принципы работы</a>
    </p>
  </div>

  <div class="btn-group">
