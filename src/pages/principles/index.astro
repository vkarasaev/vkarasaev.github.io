    padding: 0 0 3px;
    border: 0;
    border-bottom: 1px solid rgba(201, 169, 110, 0.45);
    border-radius: 0;
    background: transparent;
    color: var(--gold);
    cursor: pointer;
    font-family: 'Jost', sans-serif;
    font-size: 10.5px;
