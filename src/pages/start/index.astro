    </a>
  </div>

  <div class="sep"><div class="sep-line"></div><div class="sep-dot"></div><div class="sep-line"></div></div>

  <!-- ══ ФОРМАТ И СТОИМОСТЬ ══ -->
  <div class="section">

    <div class="section-label">Формат и стоимость</div>
    <div class="format-table">
