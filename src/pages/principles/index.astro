  }

  .agreement-list summary::after {
    content: '+';
    color: #8a6428;
    font-size: 20px;
    line-height: 1;
    transition: transform 0.2s ease;
  }

  .agreement-list details[open] summary::after {
    transform: rotate(45deg);
  }

  .agreement-list summary:focus-visible {
    outline-color: #8a6428;
  }

  .agreement-summary {
    display: grid;
    gap: 6px;
  }

  .agreement-summary strong {
