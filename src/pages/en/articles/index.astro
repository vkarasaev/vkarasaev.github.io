---
// /en/articles/ (переработка 2026-07-12, D6: «articles», не «blog»).
// Структура сверена с RU /blog/: избранное, все тексты с обложками, «where I write».
// Без тегов-фильтров: EN-полка пока небольшая, страницы тегов существуют только для RU.
import Page from '../../../layouts/Page.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('blog', ({ data }) => !data.draft && data.lang === 'en'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = all.filter((p) => p.data.featured);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const clean = (t: string) => t.replace(' Placeholder essay: to be replaced or edited by Valeriy.', '');
---

<Page
  title="Articles · Valeriy Karasaev"
  description="Essays in English on burnout, transitions, leadership loneliness and staying alive at work. By a Gestalt therapist and executive coach."
  lang="en"
  wide={true}
  translation="/blog/"
>
  <div class="page-head">
    <div class="kicker">Articles</div>
    <h1 class="page-title">Essays in English</h1>
    <p class="lead">
      On burnout, transitions and staying human at work. No advice, no checklists,
      no tidy wisdom at the end. Most of my writing lives in Russian - the English shelf is growing.
    </p>
  </div>

  <div class="meta-line"><span class="meta-num">01</span><span class="meta-label">Featured</span></div>
  <div class="grid-3">
    {featured.map((p) => (
      <a class="post-card" href={`/blog/${p.id.replace(/^en\//, '')}/`}>
        {p.data.cover && <img src={p.data.cover} alt={p.data.title} style="width: 100%; aspect-ratio: 3/2; object-fit: cover; border-radius: 8px; margin-bottom: 12px;" loading="lazy" />}
        <div class="post-date">{fmt(p.data.date)}</div>
        <div class="post-title">{p.data.title}</div>
        <div class="post-desc">{clean(p.data.description)}</div>
      </a>
    ))}
  </div>

  <div class="meta-line"><span class="meta-num">02</span><span class="meta-label">All essays</span></div>
  <div class="grid-2">
    {all.map((p) => (
      <a class="post-card" href={`/blog/${p.id.replace(/^en\//, '')}/`}>
        {p.data.cover && <img src={p.data.cover} alt={p.data.title} style="width: 100%; aspect-ratio: 3/2; object-fit: cover; border-radius: 8px; margin-bottom: 12px;" loading="lazy" />}
        <div class="post-date">{fmt(p.data.date)}</div>
        <div class="post-title">{p.data.title}</div>
        <div class="post-desc">{clean(p.data.description)}</div>
        {p.data.tags.length > 0 && <div class="post-tags">{p.data.tags.map((t) => '#' + t).join('  ')}</div>}
      </a>
    ))}
  </div>

  <div class="meta-line"><span class="meta-num">03</span><span class="meta-label">Where else I write</span></div>
  <div class="grid-2">
    <a class="write-card" href="https://www.linkedin.com/in/karasaev/" target="_blank" rel="noopener">
      <img src="/images/photo/en-portrait.jpg" alt="LinkedIn" />
      <div>
        <div class="write-title">LinkedIn</div>
        <div class="write-desc">Posts on work, leadership and staying alive in demanding systems</div>
      </div>
    </a>
    <a class="write-card" href="https://t.me/valera_outloud" target="_blank" rel="noopener">
      <img src="/images/photo/avatar.jpg" alt="Valera. Out loud" />
      <div>
        <div class="write-title">Telegram · «Валера. Вслух»</div>
        <div class="write-desc">In Russian: anger, the body, desire, shame and the joys of being alive</div>
      </div>
    </a>
    <a class="write-card" href="https://www.instagram.com/karasaev.psy" target="_blank" rel="noopener">
      <img src="/images/photo/about-camino.jpg" alt="Instagram" />
      <div>
        <div class="write-title">Instagram</div>
        <div class="write-desc">The visual side of the same life</div>
      </div>
    </a>
    <a class="write-card" href="https://dzen.ru/valera_toptop" target="_blank" rel="noopener">
      <img src="/images/photo/cover-backpack.jpg" alt="Top-top" />
      <div>
        <div class="write-title">Dzen · «Топ-топ»</div>
        <div class="write-desc">In Russian: the Camino, roads, cities and inner transitions</div>
      </div>
    </a>
  </div>
</Page>
