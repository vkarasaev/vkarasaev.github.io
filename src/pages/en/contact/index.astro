---
// /en/contact/ (переработка 2026-07-12): структура сверена с RU /contact/.
// EN-отличия: без телефона и московской карты (аудитория онлайн), расписание в CET,
// карточки «where I read» под EN-аудиторию (LinkedIn вместо B17/Дзен).
import Page from '../../../layouts/Page.astro';
import { site } from '../../../data/site';
import SocIcons from '../../../components/SocIcons.astro';
---

<Page
  title="Contact · Valeriy Karasaev"
  description="How to reach Valeriy Karasaev: WhatsApp, Telegram, email. Book a free 30-minute intro call. Sessions in English, online."
  lang="en"
  translation="/contact/"
>
  <!-- «Правки-6» п.17: для аудитории из Германии основной канал - WhatsApp,
       Telegram - дополнительный. Номер не подаем как телефон для звонков:
       прямо пишем «send a message», дальше договариваемся о видеозвонке. -->
  <div class="page-head">
    <div class="kicker">Contact</div>
    <h1 class="page-title">Writing to me is already a step</h1>
    <p class="lead">
      The easiest way is to send me a message on
      <a href={site.en.whatsappHref} style="color: var(--gold);">WhatsApp</a> or <a href="https://t.me/vkarasaev" style="color: var(--gold);">Telegram</a>.
      I answer personally, usually within a day. We will agree on a time for a video
      call, and I will send you the meeting link. You can simply write
      «I'd like a free intro call». Telegram and email work just as well.
    </p>
  </div>

  <div class="meta-line"><span class="meta-num">01</span><span class="meta-label">Reach me</span></div>
  <div class="spec">
    <div class="spec-row"><span class="spec-key">WhatsApp</span><span class="spec-val"><a href={site.en.whatsappHref} style="color: var(--gold); text-decoration: none;">{site.en.whatsapp}</a></span></div>
    <div class="spec-row"><span class="spec-key">Telegram</span><span class="spec-val"><a href={site.telegram} style="color: var(--gold); text-decoration: none;">{site.telegramHandle}</a></span></div>
    <div class="spec-row"><span class="spec-key">Email</span><span class="spec-val"><a href={'mailto:' + site.email} style="color: var(--gold); text-decoration: none;">{site.email}</a></span></div>
    <div class="spec-row"><span class="spec-key">Session hours</span><span class="spec-val">{site.en.schedule}</span></div>
    <div class="spec-row"><span class="spec-key">Format</span><span class="spec-val">online · English or Russian</span></div>
    <div class="spec-row"><span class="spec-key">Intro call</span><span class="spec-val">free · 30 minutes</span></div>
  </div>

  <div class="meta-line"><span class="meta-num">02</span><span class="meta-label">Where I write</span></div>
  <div class="grid-2 contact-links">
    <a class="write-card" href="/en/articles/">
      <img src="/images/photo/cover-snaruzhi.jpg" alt="Articles" />
      <div>
        <div class="write-title">Essays in English</div>
        <div class="write-desc">Burnout, transitions and staying human at work - collected on this site</div>
      </div>
    </a>
    <a class="write-card" href="https://www.linkedin.com/in/karasaev/" target="_blank" rel="noopener">
      <img src="/images/photo/en-portrait.jpg" alt="LinkedIn" />
      <div>
        <div class="write-title">LinkedIn</div>
        <div class="write-desc">Posts on work, leadership and staying alive in demanding systems</div>
      </div>
    </a>
    <a class="write-card" href="https://t.me/valera_outloud" target="_blank" rel="noopener">
      <img src="/images/photo/avatar.jpg" alt="Valera. Out loud" />
      <div>
        <div class="write-title">Telegram channel «Валера. Вслух»</div>
        <div class="write-desc">In Russian: anger, the body, desire, shame and the joys of being alive</div>
      </div>
    </a>
    <a class="write-card" href="https://www.instagram.com/karasaev.psy" target="_blank" rel="noopener">
      <img src="/images/photo/about-camino.jpg" alt="Instagram" />
      <div>
        <div class="write-title">Instagram</div>
        <div class="write-desc">The visual side of the same life</div>
      </div>
    </a>
  </div>
  <SocIcons />
</Page>
