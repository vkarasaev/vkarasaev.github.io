---
// Версия 9б (для сравнения, не для выпуска): после независимого ревью, до пяти правок Валерия.
// Версия 9 лендинга направления: одна система, описана в начале src/styles/direction-v9.css.
// Каждый раздел стоит на сетке «вопрос слева, ответ справа». Исключения: первый экран,
// светлая карточка «С чего можно начать» и общий блок сайта в конце.
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';
import { site } from '../../data/site';
import { getBlogFormatLabel, getBlogHref, getBlogSlug } from '../../utils/blog';
import { plural, typograf } from '../../utils/typograf';
import '../../styles/direction-v9b.css';

export interface Props {
  direction: any;
}
const { direction: d } = Astro.props;
const t = typograf;
const introMinutes = site.intro.minutes;

const headlineLines = d.hero.headlineLines ?? [d.hero.headline];
const price = `${site.session.priceRub} / ${site.session.priceEur}`;
const facts = [
  [site.session.durationShort, 'индивидуальная сессия'],
  [price, 'стоимость'],
  ['Онлайн', 'или очно в Москве'],
  [`${introMinutes} минут`, 'бесплатное знакомство'],
];
const startTerms = [
  ['Индивидуальная сессия', site.session.durationShort],
  ['Стоимость', price],
  ['Где', 'Онлайн или очно в Москве'],
  ['Как часто', 'Обычно раз в неделю; частоту обсуждаем вместе'],
];
const startNote = `Если сначала хочется познакомиться и задать вопросы о формате, можно договориться о бесплатной встрече на ${introMinutes} минут.`;

const workRows = [...(d.work.options ?? []), ...(d.work.after ?? [])];
const gold = (text: string) => t(text).replace(/^((?:А\s|А&nbsp;|А )?[Ии]ногда)/, '<span class="d9-gold">$1</span>');

const posts = await getCollection('blog', ({ data }) => !data.draft && data.lang === 'ru');
const bySlug = new Map(posts.map((post) => [getBlogSlug(post), post]));
const series = d.materials?.series ? bySlug.get(d.materials.series) : undefined;
const partSlugs = series
  ? [...new Set([...(series.body ?? '').matchAll(/\]\(\/blog\/([^)\s/]+)\/\)/g)].map((m) => m[1]))]
  : [];
const parts = partSlugs.map((slug) => bySlug.get(slug)).filter((post) => post !== undefined);
const articles = (d.materials?.articles ?? []).map((slug: string) => bySlug.get(slug)).filter((post: unknown) => post !== undefined);
const pad = (n: number) => String(n).padStart(2, '0');
const personalChannel = site.channels[0]?.label ?? 'Telegram';
---

<Page title={d.meta.title} description={d.meta.description} noindex={true} wide={true}>
  <article class="d9">
    <header class="d9-hero">
      <img class="d9-hero-photo" src={d.hero.photo.src} alt={d.hero.photo.alt} width="1536" height="1024" />
      <div class="d9-hero-copy d9-rise">
        <p class="d9-meta">{d.topic}</p>
        <h1 class="d9-display">
          {headlineLines.map((line: string) => <><span set:html={t(line)} />{' '}</>)}
        </h1>
        {d.hero.sub && <p class="d9-hero-sub" set:html={t(d.hero.sub)} />}
        <div class="d9-hero-cta">
          <a class="d9-btn" href={site.telegram}>{d.hero.cta}</a>
          <p class="d9-hero-who">{site.name} · психолог, гештальт-терапевт</p>
        </div>
      </div>
    </header>

    <dl class="d9-facts" aria-label="Условия">
      {facts.map(([value, label]) => (<div><dt set:html={t(value)} /><dd>{label}</dd></div>))}
    </dl>

    <section class="d9-sec" aria-label="О чём эта страница">
      <div class="d9-intro">
        {d.hero.lead.map((p: string) => <p set:html={t(p)} />)}
      </div>
    </section>

    <section class="d9-sec d9-band" id="situations" aria-labelledby="situations-title">
      <div class="d9-rail">
        <h2 class="d9-head" id="situations-title" set:html={t(d.recognition.title)} />
        <ul class="d9-rows d9-rows--state">
          {d.recognition.items.map((item: string) => <li set:html={`<p>${t(item)}</p>`} />)}
        </ul>
      </div>
    </section>

    <section class="d9-sec" id="questions" aria-labelledby="questions-title">
      <div class="d9-rail">
        <h2 class="d9-head" id="questions-title" set:html={t(d.insight.title)} />
        <div class="d9-acc">
          {d.insight.rows.map((row: any) => (
            <details class="d9-card">
              <summary><h3 class="d9-state" set:html={t(row.title)} /></summary>
              <div class="d9-acc-body">
                {row.blocks.map((b: any) =>
                  b.type === 'p' ? (
                    <p set:html={t(b.html)} />
                  ) : b.type === 'questions' ? (
                    <ul class="d9-rows d9-rows--ask">
                      {b.items.map((q: string) => <li set:html={`<p>${t(q)}</p>`} />)}
                    </ul>
                  ) : (
                    <dl class="d9-defs">
                      {b.items.map((c: any) => (
                        <div><dt set:html={t(c.term)} /><dd set:html={t(c.text)} /></div>
                      ))}
                    </dl>
                  ),
                )}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="d9-sec d9-band" id="approach" aria-labelledby="approach-title">
      <div class="d9-rail">
        <h2 class="d9-head" id="approach-title" set:html={t(d.work.title)} />
        <div class="d9-answer">
          <div class="d9-prose">
            {d.work.paragraphs.map((p: string) => <p set:html={t(p)} />)}
          </div>
          {workRows.length > 0 && (
            <ul class="d9-rows">
              {workRows.map((o: string) => <li set:html={`<p>${gold(o)}</p>`} />)}
            </ul>
          )}
        </div>
        {d.work.thesis && <p class="d9-head d9-quote d9-wide" set:html={t(d.work.thesis)} />}
      </div>
    </section>

    <section class="d9-sec" id="author" aria-labelledby="author-title">
      <div class="d9-rail">
        <h2 class="d9-head" id="author-title" set:html={t(d.author.title)} />
        <div class="d9-answer">
          {d.author.photo && (
            <div class="d9-shot">
              <img src={d.author.photo.src} alt={d.author.photo.alt} width="1536" height="1024" loading="lazy" style={d.author.photo.position ? `object-position: ${d.author.photo.position}` : undefined} />
            </div>
          )}
          <div class="d9-prose">
            {d.author.paragraphs.map((p: string) => <p set:html={t(p)} />)}
          </div>
          <p class="d9-links">
            <a class="d9-link" href="/about/">Обо мне</a>
            <a class="d9-link" href="/business/">Опыт в бизнесе</a>
            <a class="d9-link" href="/credentials/">Образование</a>
          </p>
        </div>
      </div>
    </section>

    <section class="d9-sec" id="start" aria-labelledby="start-title">
      <div class="d9-start">
        <div class="d9-start-main">
          <h2 class="d9-head" id="start-title" set:html={t(d.start.title)} />
          <p set:html={t(d.startIntro)} />
          <div class="d9-start-actions">
            <a class="d9-btn" href={site.telegram}>{d.start.cta}</a>
            <a class="d9-link" href="/therapy/">Подробнее о терапии</a>
          </div>
        </div>
        <div>
          <dl class="d9-terms">
            {startTerms.map(([key, value]) => (<div><dt>{key}</dt><dd set:html={t(value)} /></div>))}
          </dl>
          <p class="d9-terms-note" set:html={t(startNote)} />
        </div>
      </div>
    </section>

    {d.materials && (series || articles.length > 0) && (
      <section class="d9-sec d9-band" id="reading" aria-labelledby="reading-title">
        <div class="d9-rail">
          <h2 class="d9-head" id="reading-title" set:html={t(d.materials.title)} />
          <div class="d9-answer">
            {series && (
              <div class="d9-series">
                <a href={getBlogHref(series)} tabindex="-1" aria-hidden="true">
                  {series.data.cover && <img src={series.data.cover} alt="" width="988" height="659" loading="lazy" />}
                </a>
                <div class="d9-series-text">
                  <p class="d9-meta">Цикл{parts.length > 0 && `, ${parts.length} ${plural(parts.length, ['статья', 'статьи', 'статей'])}`}</p>
                  <h3 class="d9-state"><a href={getBlogHref(series)} set:html={t(series.data.title.replace(/^Цикл\s+/, ''))} /></h3>
                  <p set:html={t(series.data.description)} />
                </div>
              </div>
            )}
            {parts.length > 0 && (
              <ol class="d9-rows d9-rows--num">
                {parts.map((part: any, i: number) => (
                  <li><a href={getBlogHref(part)}><span class="d9-meta" aria-hidden="true">{pad(i + 1)}</span><span set:html={t(part.data.title)} /></a></li>
                ))}
              </ol>
            )}
            {articles.length > 0 && (
              <ul class="d9-articles">
                {articles.map((post: any) => (
                  <li>
                    <a class="d9-article d9-card" href={getBlogHref(post)}>
                      {post.data.cover && <img src={post.data.cover} alt="" width="482" height="271" loading="lazy" />}
                      <span class="d9-article-text">
                        <span class="d9-meta">{getBlogFormatLabel(post.data.format)}</span>
                        <span class="d9-state" set:html={t(post.data.title)} />
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </div>
      </section>
    )}

    {d.personal && (
      <section class="d9-sec" id="personal" aria-labelledby="personal-title">
        <div class="d9-rail">
          <h2 class="d9-head" id="personal-title" set:html={t(d.personal.title)} />
          <div class="d9-answer">
            <p set:html={t(d.personal.intro)} />
            <div class="d9-posts-wrap">
            <p class="d9-meta">{personalChannel}</p>
            <ul class="d9-posts">
              {d.personal.items.map((item: any) => (
                <li>
                  <a href={item.href} target="_blank" rel="noopener">
                    {item.thumb && <img src={item.thumb} alt="" width="88" height="88" loading="lazy" />}
                    <span class="d9-posts-text">
                      <span class="d9-state" set:html={t(item.title)} />
                      <span set:html={t(item.note)} />
                    </span>
                  </a>
                </li>
              ))}
            </ul>
            </div>
          </div>
        </div>
      </section>
    )}
  </article>
</Page>
