---
// ЧЕРНОВИК главной 11 (21.11.2026): вариант 9 с двумя укороченными названиями, для сравнения с /draft-home-9/.
// Копия src/pages/index.astro, меняется только секция тем. Адрес /draft-home-4/ на сайт не попадает (astro.config).
// ГЛАВНАЯ (бывшая /home, переезд 2026-07-14): полная страница - каноническая
// главная для всех экранов, индексируется. Компактный линк-хаб переехал на
// /start/ (лендинг для ссылок из соцсетей), /home/ редиректит сюда (astro.config).
// Логика: hero-обещание → «это про вас» → доверие (два мира) → как работает →
// форматы → тексты → живой человек → финальный CTA. Всё в каноне Premium Dark.
import Base from '../../layouts/Base.astro';
import Burger from '../../components/Burger.astro';
import SocIcons from '../../components/SocIcons.astro';
import { site } from '../../data/site';
import { getCollection } from 'astro:content';
import { getBlogFormatLabel, getBlogHref } from '../../utils/blog';
import '../../styles/main.css';
import '../../styles/inner.css';
import '../../styles/home.css';
import '../../styles/home-topics-draft.css';
import { homeTopics, topicLinkLabel } from '../../data/homeTopics';
// Только для сравнения: два названия короче, чтобы на телефоне умещались в одну строку. Не утверждены.
const shortTitles = {
  'Иммиграция: адаптация, одиночество и пустота': 'Иммиграция: адаптация и одиночество',
  'Кризис в отношениях: близость и зависимость': 'Отношения: близость и зависимость',
};
const topics = homeTopics.map((x) => ({ ...x, t: shortTitles[x.t] ?? x.t }));

const posts = (await getCollection('blog', ({ data }) => !data.draft && data.lang === 'ru' && data.featured))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
// «Правки-6» п.10: на главной показываем только 3 последних текста, а полный список - на /blog/
const allBlogPosts = await getCollection('blog', ({ data }) => !data.draft && data.lang === 'ru');
const tags = [...new Set(allBlogPosts.flatMap((p) => p.data.tags ?? []))].sort();

const fmt = (d) => d.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base
  title="Валерий Карасаев · Психолог, гештальт-терапевт, супервизор"
  description="Психолог и гештальт-терапевт для взрослых в кризисе или переходе: выгорание, развод, иммиграция, потеря смысла, одиночество руководителя. Практика с 2014. Онлайн и очно в Москве, 5000 ₽."
  lang="ru"
  translation="/en/"
  noindex
>
  <header class="site-header">
    <div class="site-header-in">
      <a class="brand" href="/">Валерий Карасаев</a>
      <nav class="nav">
        <a href="/therapy/">Терапия</a>
        <a href="/groups/vernutsya-v-kontakt/">Группа</a>
        <a href="/supervision/">Супервизия</a>
        <a href="/about/">Обо мне</a>
        <a href="/credentials/">Образование</a>
        <a href="/blog/">Блог</a>
        <a href="/contact/">Контакты</a>
        <a href="/en/" class="lang-sw">EN</a>
      </nav>
      <Burger lang="ru" />
    </div>
  </header>

  <section class="hx">
    <div class="hx-grid">
      <div class="hx-left">
        <div class="hx-kicker">{site.tagline}</div>
        <h1 class="hx-title">Кризисы<br />и жизненные<br />переходы</h1>
        <p class="hx-lead">
          Помогаю пережить выгорание, развод и иммиграцию. Работаю с тупиками в карьере и отношениях.
        </p>
        <div class="hx-cta">
          <a href={site.telegramSession} class="btn btn-primary"><span class="btn-icon">✈</span> Записаться на сессию</a>
          <a href={site.telegramFreeCall} class="btn btn-outline"><span class="btn-icon">◎</span> Бесплатная встреча · {site.intro.minutes} мин</a>
        </div>
        <div class="hx-service">{site.session.durationShort} · 5000 ₽ / 60 €</div>
        <div class="hero-socials">
            <SocIcons ids={['instagram', 'telegram', 'youtube', 'vk']} />
        </div>
      </div>
      <div class="hx-photo">
        <img src="/images/photo/home-hero.jpg" alt="Валерий Карасаев" width="1000" height="1100" />
      </div>
    </div>
  </section>

  <div class="factbar">
    <div class="factbar-in">
      <div class="fx"><div class="fx-n">с 2014</div><div class="fx-l">в частной практике</div></div>
      <div class="fx"><div class="fx-n">2500+</div><div class="fx-l">часов подготовки</div></div>
      <div class="fx"><div class="fx-n">17 лет</div><div class="fx-l">в международном бизнесе</div></div>
      <div class="fx"><div class="fx-n">12 лет</div><div class="fx-l">собственной терапии</div></div>
      <div class="fx"><div class="fx-n">RU · EN</div><div class="fx-l">онлайн и очно в Москве</div></div>
    </div>
  </div>

  <div class="hx-wrap">
    <section class="hx-sec">
      <h2 class="hx-h2">Возможно, это про вас</h2>
      <p class="hx-sub">Четыре ситуации, с которыми ко мне приходят чаще всего.</p>
      <div class="pains">
        <div class="pain"><div class="pain-q">Развод уже идёт, а привычная жизнь разваливается. Суд, жильё, дети, деньги - всё требует решений, пока ты пытаешься собрать осколки своей жизни.</div></div>
        <div class="pain"><div class="pain-q">Работа давно перестала устраивать, но слишком многое держится на ней. Доход, статус, привычки. Уйти страшно, но и оставаться с каждым годом всё тяжелее.</div></div>
        <div class="pain"><div class="pain-q">Партнёры меняются, а в отношениях всё повторяется. Тревога, контроль, обиды и дистанция. Сначала надежда, потом - усталость. И снова дейтинг по кругу.</div></div>
        <div class="pain"><div class="pain-q">Бизнес растёт, но совсем не так, как хочется. Работы всё больше, а сил всё меньше. Найм, делегирование и набившая оскомину мысль: может быть, всё-таки дело во мне?</div></div>
      </div>
    </section>

    <!-- ЧЕРНОВИК: Вариант 9. От 640px плашки варианта 4; на телефоне раскрытие с плюсами (.wk, как сейчас на главной), без фото.
         Ссылка только у «Карьеры»: на плашке вся плашка, в раскрытии золотая строка как «Как выбрать формат →». -->
    <section class="hx-sec tp-band tp-band-wide">
      <h2 class="hx-h2">Основные темы моей практики</h2>
      <div class="wk tq-phone">
        {topics.map((x) => (
          <details>
            <summary><span class="wk-t">{x.t}</span></summary>
            <div class="wk-body"><p>{x.d}</p>{!x.planned && <p style="margin-top: 10px; font-size: 14px;"><a href={x.href} style="color: var(--gold); text-decoration: none;">{topicLinkLabel} →</a></p>}</div>
          </details>
        ))}
      </div>
      <ul class="tq tq4 tq-wide">
        {topics.map((x) => {
          // Ссылка только у темы с готовым лендингом; остальные плашки - не ссылки (без пальца), рамка при наведении та же.
          const Tag = x.planned ? 'div' : 'a';
          return (
            <li><Tag class="tq-card" href={x.planned ? undefined : x.href}><img class="tq-img" src={x.img.src} alt="" style={`object-position: ${x.img.pos}`} width="600" height="400" loading="lazy" /><div class="tq-copy"><h3 class="tq-name">{x.t}</h3><p class="tq-text">{x.d}</p></div></Tag></li>
          );
        })}
      </ul>
    </section>

    <section class="hx-sec">
      <h2 class="hx-h2">Почему со мной можно про это</h2>
      <p class="hx-sub">Терапевтическая подготовка и 17 лет в международном бизнесе.</p>
      <div class="two">
        <div class="two-col">
          <h3>Глубина терапевта</h3>
          <p>Гештальт-терапевт с психоаналитическим мышлением. Магистр психологии ВШЭ, 4-летняя программа МГИ, 2500+ часов учебы.</p>
          <p>12 лет собственной терапии, больше 1000 часов. За эти годы я прожил свои кризисы и принял несколько очень трудных решений - поэтому слышу то, о чём обычно молчат.</p>
        </div>
        <div class="two-col">
          <h3>Опыт в бизнесе</h3>
          <p>До практики - 17 лет в международном бизнесе: Abbott, BMW, Bosch, команды до 300 человек в 30 странах.</p>
          <p>Это не значит, что я работаю только с бизнесом. Это значит, что давление, ответственность и цену решений я знаю изнутри - в какой бы форме они ни пришли к вам.</p>
        </div>
      </div>
    </section>

    <section class="hx-sec">
      <h2 class="hx-h2">С чего начинается работа</h2>
      <p class="hx-sub">Можно начать со знакомства и потом решить, идти ли дальше.</p>
      <div class="steps">
        <div class="step">
          <div class="step-n">01</div>
          <div class="step-b"><h4>Написать мне</h4><p>Договориться о времени, задать вопросы - или созвониться на {site.intro.minutes} минут, познакомиться.</p></div>
        </div>
        <div class="step">
          <div class="step-n">02</div>
          <div class="step-b"><h4>Первая сессия</h4><p>Знакомимся, разбираемся в запросе - даже если он ещё не сформулирован - и начинаем работать.</p></div>
        </div>
        <div class="step">
          <div class="step-n">03</div>
          <div class="step-b"><h4>Регулярная работа</h4><p>Обычно раз в неделю. Темп и глубину выбираем вместе и регулярно сверяемся, туда ли идём.</p></div>
        </div>
      </div>
    </section>

    <section class="hx-sec">
      <h2 class="hx-h2">Форматы работы</h2>
      <p class="hx-sub">Не знаете, что подойдёт, - начните с бесплатной встречи, разберёмся вместе.</p>
      <div class="fmts">
        <a class="fmt lead-fmt" href="/therapy/">
          <div class="fmt-tag">Основной формат</div>
          <div class="fmt-t">Индивидуальная терапия</div>
          <div class="fmt-d">Кризисы, переходы, глубокая личная работа. {site.session.durationShort}, раз в неделю, онлайн или очно в Москве.</div>
          <div class="fmt-price">5000 ₽ / 60 € за сессию</div>
        </a>
        <a class="fmt" href="/groups/">
          <div class="fmt-tag">Идёт запись</div>
          <div class="fmt-t">Терапевтические группы</div>
          <div class="fmt-d">Увидеть свои способы быть с людьми вживую. «Вернуться в контакт» на русском и «Work, People, Ambition» на английском.</div>
          <div class="fmt-price">от 3000 ₽ за встречу</div>
        </a>
        <a class="fmt" href="/supervision/">
          <div class="fmt-tag">Для психологов</div>
          <div class="fmt-t">Супервизия</div>
          <div class="fmt-d">Развитие практики: как рассказать о себе, набрать клиентов и вести соцсети. И разбор клиентских случаев.</div>
          <div class="fmt-price">Разово или регулярно · онлайн</div>
        </a>
      </div>
      <p style="margin-top: 16px; font-size: 14px;"><a href="/format/" style="color: var(--gold); text-decoration: none;">Как выбрать формат →</a></p>
    </section>

    <section class="hx-sec">
      <h2 class="hx-h2">Живой человек, а не функция</h2>
      <div class="human">
        <img src="/images/photo/home-life.jpg" alt="Валерий на Камино-де-Сантьяго" loading="lazy" />
        <div class="prose">
          <p>У меня двое детей и три гитары. Я прошёл Камино-де-Сантьяго, поднимался на Эльбрус, купался в Ганге. Коллеги говорят, что я «больше папа, чем мама» и похож на морячка.</p>
          <p>Я не решаю свои проблемы за счёт клиента и не изображаю невозмутимого эксперта. В кабинете - обычный живой человек, который сам прошёл через многое из того, с чем к нему приходят.</p>
          <p>Пишу канал «Валера. Вслух» - про злость, тело, желание и жизненные радости. Играю блюз. Люблю дорогу и не люблю умные слова, за которыми пусто.</p>
          <p><a href="/about/">Обо мне подробнее</a> · <a href="/business/">опыт в бизнесе</a> · <a href="/credentials/">образование</a></p>
        </div>
      </div>
    </section>

    {posts.length > 0 && (
      <section class="hx-sec">
        <h2 class="hx-h2">Как я думаю - в текстах</h2>
        <p class="hx-sub">Про выгорание, кризисы и живость. Без советов и мотивационных сказок.</p>
        <div class="tag-row" style="margin-bottom: 24px;">
          <a href="/blog/" class="tag-chip active">Все</a>
          {tags.map((tag) => (<a href={`/blog/tag/${tag}/`} class="tag-chip"> #{tag}</a>))}
        </div>
        <div class="posts3">
          {posts.map((p) => (
            <article class="post-card">
              {p.data.cover && <img src={p.data.cover} alt={p.data.title} style="width: 100%; aspect-ratio: 3/2; object-fit: cover; border-radius: 8px; margin-bottom: 12px;" loading="lazy" />}
              <div class="post-card-meta">
                <a href={`/blog/format/${p.data.format}/`} class="post-format">{getBlogFormatLabel(p.data.format)}</a>
                <span class="post-date">{fmt(p.data.date)}</span>
              </div>
              <div class="post-title"><a class="post-main-link" href={getBlogHref(p)}>{p.data.title}</a></div>
            </article>
          ))}
        </div>
        <p style="margin-top: 24px;"><a href="/blog/" class="tag-chip">Показать еще →</a></p>
      </section>
    )}

    <!-- «Правки-6» п.12: дополнительный воздух перед блоком -->
    <section class="hx-sec hx-sec-gap">
      <h2 class="hx-h2">Где ещё меня читать и смотреть</h2>
      <div class="grid-2">
        <a class="write-card" href="https://t.me/valera_outloud" target="_blank" rel="noopener">
          <img src="/images/photo/valera-vsluh.jpg" alt="Валера. Вслух" />
          <div>
            <div class="write-title">Telegram · «Валера. Вслух»</div>
            <div class="write-desc">Личные эссе о злости, теле, желании, стыде и живой жизни</div>
          </div>
        </a>
        <a class="write-card" href="https://www.instagram.com/karasaev.psy" target="_blank" rel="noopener">
          <img src="/images/photo/instagram-green.jpg" alt="Instagram" />
          <div>
            <div class="write-title">Instagram · фотографии и сторис</div>
            <div class="write-desc">Будни, лица и всё, что проще показать, чем объяснить</div>
          </div>
        </a>
        <a class="write-card" href="https://www.youtube.com/@vkarasaev" target="_blank" rel="noopener">
          <img src="/images/photo/youtube-pipe-avatar.jpg" alt="YouTube" />
          <div>
            <div class="write-title">YouTube · подкасты и видео</div>
            <div class="write-desc">Подкасты и длинные разговоры о терапии, кризисах и переменах</div>
          </div>
        </a>
        <a class="write-card" href="https://dzen.ru/valera_toptop" target="_blank" rel="noopener">
          <img src="/images/photo/about-camino.jpg" alt="Camino" />
          <div>
            <div class="write-title">«Топ-топ» · путевой дневник</div>
            <div class="write-desc">Записки с Camino, дорога, города и стертые пятки</div>
          </div>
        </a>
      </div>
    </section>
  </div>

  <section class="hx-cta-final-wrap">
    <div class="cta-final">
      <!-- «Правки-6» п.11: CTA приглашает к контакту, а не продвигает один
           сценарий. Основная кнопка - просто «написать», варианты - в подписи. -->
      <div class="cta-title">Первый шаг - просто написать</div>
      <div class="cta-sub">Задать вопрос, договориться о бесплатном {site.intro.minutes}-минутном созвоне - или записаться на сессию. Как удобнее</div>
      <div class="btn-group" style="margin: 0;">
        <a href={site.telegram} class="btn btn-primary">Написать в Telegram</a>
        <a href={'mailto:' + site.email} class="btn btn-outline">{site.email}</a>
      </div>
    </div>
  </section>

  <footer class="site-footer">
    <div class="site-footer-in">
      <span>Валерий Карасаев · психолог, гештальт-терапевт</span>
      <span><a href={site.telegram}>{site.telegramHandle}</a> · <a href={'mailto:' + site.email}>{site.email}</a> · <a href={site.phoneHref}>{site.phone}</a></span>
      <span><a href="/principles/">Принципы</a> · <a href="/privacy/">Конфиденциальность</a> · <a href="/terms/">Условия</a> · <a href="/sos/">SOS</a></span>
    </div>
  </footer>
</Base>
