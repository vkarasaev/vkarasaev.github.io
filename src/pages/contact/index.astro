---
// /contact/ (T8): все способы связи + куда подписаться. Данные только из site.ts.
import Page from '../../layouts/Page.astro';
import { site } from '../../data/site';
---

<Page
  title="Контакты · Валерий Карасаев"
  description="Как связаться с Валерием Карасаевым: Telegram, почта, телефон. Запись на сессию и бесплатную 15-минутную встречу-знакомство. Telegram-канал, B17, Дзен."
  translation="/en/contact/"
>
  <div class="page-head">
    <div class="kicker">Контакты</div>
    <h1 class="page-title">Написать мне - это уже шаг</h1>
    <p class="lead">
      Самый быстрый способ - Telegram. Отвечаю лично, обычно в течение дня.
      Можно сразу написать «хочу записаться на сессию» - и мы договоримся о времени.
    </p>
  </div>

  <div class="meta-line"><span class="meta-num">01</span><span class="meta-label">Связь</span></div>
  <div class="spec">
    <div class="spec-row"><span class="spec-key">Telegram</span><span class="spec-val"><a href={site.telegram} style="color: var(--gold); text-decoration: none;">{site.telegramHandle}</a></span></div>
    <div class="spec-row"><span class="spec-key">Почта</span><span class="spec-val"><a href={'mailto:' + site.email} style="color: var(--gold); text-decoration: none;">{site.email}</a></span></div>
    <div class="spec-row"><span class="spec-key">Телефон</span><span class="spec-val"><a href={site.phoneHref} style="color: var(--gold); text-decoration: none;">{site.phone}</a></span></div>
    <div class="spec-row"><span class="spec-key">Расписание сессий</span><span class="spec-val">{site.session.schedule}</span></div>
    <div class="spec-row"><span class="spec-key">Очно</span><span class="spec-val">{site.session.offline}</span></div>
  </div>

  <div class="meta-line"><span class="meta-num">02</span><span class="meta-label">Где меня читать</span></div>
  <div class="grid-2">
    <a class="write-card" href="/blog/">
      <img src="/images/photo/cover-sobaka.jpg" alt="Блог" />
      <div>
        <div class="write-title">Избранные статьи на сайте</div>
        <div class="write-desc">Выгорание, кризисы, терапия без ботвы - лучшие тексты собраны в блоге</div>
      </div>
    </a>
    <a class="write-card" href="https://t.me/valera_outloud">
      <img src="/images/photo/avatar.jpg" alt="Валера. Вслух" />
      <div>
        <div class="write-title">Телеграм-канал «Валера. Вслух»</div>
        <div class="write-desc">Про злость, тело, желание, стыд, жадность и жизненные радости</div>
      </div>
    </a>
    <a class="write-card" href="https://dzen.ru/valera_toptop">
      <img src="/images/photo/cover-backpack.jpg" alt="Топ-топ" />
      <div>
        <div class="write-title">Блог о дороге «Топ-топ»</div>
        <div class="write-desc">Camino, дороги, города и внутренние переходы</div>
      </div>
    </a>
    <a class="write-card" href="https://www.b17.ru/karasaev/#article">
      <img src="/images/photo/about-today.jpg" alt="B17" />
      <div>
        <div class="write-title">Статьи о психологии на B17</div>
        <div class="write-desc">Кейсы, разборы теории и практики</div>
      </div>
    </a>
  </div>
  <div class="soc-row" style="margin-top: 22px;">
    <a href="https://www.instagram.com/karasaev.psy" aria-label="Instagram" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2.5" y="2.5" width="19" height="19" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none"/></svg></a>
    <a href="https://www.facebook.com/valery.karasaev" aria-label="Facebook" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M15 8h2.5V4.5H15c-2.5 0-4 1.5-4 4V11H8v3.5h3V21h3.5v-6.5h2.7l.55-3.5H14.5V9c0-.6.4-1 .5-1z"/></svg></a>
    <a href="https://www.linkedin.com/in/karasaev/" aria-label="LinkedIn" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2.5" y="2.5" width="19" height="19" rx="3"/><line x1="7.5" y1="10.5" x2="7.5" y2="17"/><circle cx="7.5" cy="7.3" r="0.6" fill="currentColor"/><path d="M11.5 17v-4a2.2 2.2 0 0 1 4.4 0v4"/><line x1="11.5" y1="10.5" x2="11.5" y2="17"/></svg></a>
    <a href="https://vk.com/vkarasaev" aria-label="ВКонтакте" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2.5" y="2.5" width="19" height="19" rx="5"/><path d="M6.5 9c.4 3.4 2.4 6 5 6v-3c1.2 0 2.4 1.2 3 3h2.5c-.5-2-1.6-3.3-2.7-3.9 1-.7 2-1.9 2.4-3.1h-2.4c-.5 1.3-1.6 2.6-2.8 2.7V9H9.3"/></svg></a>
    <a href="https://www.threads.com/@karasaev.psy" aria-label="Threads" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M12 21c-4.5 0-7.5-3-7.5-9S7.5 3 12 3c3.8 0 6.4 2 7.2 5.3l-2.3.6C16.4 6.5 14.6 5.2 12 5.2c-3.2 0-5.1 2.2-5.1 6.8s1.9 6.8 5.1 6.8c2.6 0 4.2-1.2 4.2-2.9 0-1.4-1-2.3-2.9-2.5.3-.9.4-1.9.2-2.8-2 .1-3.5.9-3.5 2.2h-2.2c0-2.6 2.4-4.3 5.7-4.3.4 0 .8 0 1.1.1 2.8.4 4.5 2.1 4.5 4.6v.4c1 .8 1.6 1.9 1.6 3-.1 2.9-2.7 4.4-6.7 4.4z"/></svg></a>
  </div>
</Page>
