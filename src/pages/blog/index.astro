---
// /blog/ (обновлено по правкам 8 июля): теги-фильтры сверху, обложки,
// блок «где я пишу еще». Болванки помечены в самих статьях.
import Page from '../../layouts/Page.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('blog', ({ data }) => !data.draft && data.lang === 'ru'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = all.filter((p) => p.data.featured);
const tags = [...new Set(all.flatMap((p) => p.data.tags))].sort();
const fmt = (d: Date) => d.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
const clean = (t: string) => t.replace(' Болванка: заменить на реальный текст Валерия.', '');
---

<Page
  title="Блог · Валерий Карасаев"
  description="Тексты психолога и гештальт-терапевта: выгорание, кризисы и переходы, терапия без ботвы, дорога и живость. Фильтр по темам."
  wide={true}
  hideCta={true}
  translation="/en/articles/"
>
  <div class="page-head">
    <div class="kicker">Блог</div>
    <h1 class="page-title">Тексты</h1>
    <p class="lead">
      Про кризисы, переходы, выгорание и живость. Без советов, чек-листов и аккуратной мудрости в финале.
    </p>
  </div>

  <div class="tag-row">
    <a href="/blog/" class="tag-chip active">Все</a>
    {tags.map((t) => <a href={`/blog/tag/${t}/`} class="tag-chip">#{t}</a>)}
  </div>

  <div class="meta-line"><span class="meta-num">01</span><span class="meta-label">Избранное</span></div>
  <div class="grid-3">
    {featured.map((p) => (
      <a class="post-card" href={`/blog/${p.id.replace(/^ru\//, '')}/`}>
        {p.data.cover && <img src={p.data.cover} alt={p.data.title} style="width: 100%; aspect-ratio: 3/2; object-fit: cover; border-radius: 8px; margin-bottom: 12px;" loading="lazy" />}
        <div class="post-date">{fmt(p.data.date)}</div>
        <div class="post-title">{p.data.title}</div>
        <div class="post-desc">{clean(p.data.description)}</div>
      </a>
    ))}
  </div>

  <div class="meta-line"><span class="meta-num">02</span><span class="meta-label">Все тексты</span></div>
  <div class="grid-2">
    {all.map((p) => (
      <a class="post-card" href={`/blog/${p.id.replace(/^ru\//, '')}/`}>
        {p.data.cover && <img src={p.data.cover} alt={p.data.title} style="width: 100%; aspect-ratio: 3/2; object-fit: cover; border-radius: 8px; margin-bottom: 12px;" loading="lazy" />}
        <div class="post-date">{fmt(p.data.date)}</div>
        <div class="post-title">{p.data.title}</div>
        <div class="post-desc">{clean(p.data.description)}</div>
        {p.data.tags.length > 0 && <div class="post-tags">{p.data.tags.map((t) => '#' + t).join('  ')}</div>}
      </a>
    ))}
  </div>

  <div class="meta-line"><span class="meta-num">03</span><span class="meta-label">Где я пишу еще</span></div>
  <div class="grid-2">
    <a class="write-card" href="https://t.me/valera_outloud">
      <img src="/images/photo/avatar.jpg" alt="Валера. Вслух" />
      <div>
        <div class="write-title">Telegram · «Валера. Вслух»</div>
        <div class="write-desc">Размышляю вслух: про злость, тело, желание, стыд, жадность и жизненные радости</div>
      </div>
    </a>
    <a class="write-card" href="https://www.b17.ru/karasaev/#article">
      <img src="/images/photo/about-today.jpg" alt="B17" />
      <div>
        <div class="write-title">B17 · профессиональные тексты</div>
        <div class="write-desc">Про терапию без ботвы: кейсы, разборы теории и практики</div>
      </div>
    </a>
    <a class="write-card" href="https://dzen.ru/valera_toptop">
      <img src="/images/photo/cover-backpack.jpg" alt="Топ-топ" />
      <div>
        <div class="write-title">Дзен · «Топ-топ»</div>
        <div class="write-desc">Записки человека, который идет: Camino, дороги, города и внутренние переходы</div>
      </div>
    </a>
    <a class="write-card" href="https://www.instagram.com/karasaev.psy">
      <img src="/images/photo/about-camino.jpg" alt="Instagram" />
      <div>
        <div class="write-title">Instagram</div>
        <div class="write-desc">Визуальная часть той же жизни</div>
      </div>
    </a>
  </div>
</Page>
