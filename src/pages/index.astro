---
// ГЛАВНАЯ (бывшая /home, переезд 2026-07-14): полная страница - каноническая
// главная для всех экранов, индексируется. Компактный линк-хаб переехал на
// /start/ (лендинг для ссылок из соцсетей), /home/ редиректит сюда (astro.config).
// Логика: hero-обещание → «это про вас» → доверие (два мира) → как работает →
// форматы → тексты → живой человек → финальный CTA. Всё в каноне Premium Dark.
import Base from '../layouts/Base.astro';
import Burger from '../components/Burger.astro';
import SocIcons from '../components/SocIcons.astro';
import { site } from '../data/site';
import { getCollection } from 'astro:content';
import '../styles/main.css';
import '../styles/inner.css';
import '../styles/home.css';

const posts = (await getCollection('blog', ({ data }) => !data.draft && data.lang === 'ru' && data.featured))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
// «Правки-6» п.10: на главной показываем только 3 последних текста, а полный список - на /blog/
const allBlogPosts = await getCollection('blog', ({ data }) => !data.draft && data.lang === 'ru');
const tags = [...new Set(allBlogPosts.flatMap((p) => p.data.tags ?? []))].sort();

const fmt = (d) => d.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base
  title="Валерий Карасаев · Психолог, гештальт-терапевт, executive-коуч"
  description="Психолог и гештальт-терапевт для взрослых в кризисе или переходе: выгорание, развод, эмиграция, потеря смысла, одиночество руководителя. Практика с 2014. Онлайн и очно в Москве, 5000 ₽."
  lang="ru"
  translation="/en/"
>
  <header class="site-header">
    <div class="site-header-in">
      <a class="brand" href="/">Валерий Карасаев</a>
      <nav class="nav">
        <a href="/therapy/">Терапия</a>
        <a href="/groups/vernutsya-v-kontakt/">Группа</a>
        <a href="/about/">Обо мне</a>
        <a href="/credentials/">Образование</a>
        <a href="/blog/">Блог</a>
        <a href="/contact/">Контакты</a>
        <a href="/en/" class="lang-sw">EN</a>
      </nav>
      <Burger lang="ru" />
    </div>
  </header>

  <section class="hx">
    <div class="hx-grid">
      <div class="hx-left">
        <div class="hx-kicker">Психолог · Гештальт-терапевт · Executive-коуч</div>
        <h1 class="hx-title">Когда справляться<br />в одиночку стало<br />слишком дорого</h1>
        <p class="hx-lead">
          Помогаю взрослым пройти через кризис или большой переход - и найти новую опору.
          Я не обещаю быстро. Но обещаю честно.
        </p>
        <div class="hx-cta">
          <a href={site.telegramSession} class="btn btn-primary"><span class="btn-icon">✈</span> Записаться на сессию</a>
          <a href={site.telegramFreeCall} class="btn btn-outline"><span class="btn-icon">◎</span> Бесплатная встреча · 15 мин</a>
        </div>
        <div class="hero-socials">
            <SocIcons ids={['instagram', 'telegram', 'youtube', 'vk']} />
        </div>
      </div>
      <div class="hx-photo">
        <img src="/images/photo/home-hero.jpg" alt="Валерий Карасаев" width="1000" height="1100" />
      </div>
    </div>
  </section>

  <div class="factbar">
    <div class="factbar-in">
      <div class="fx"><div class="fx-n">с 2014</div><div class="fx-l">в частной практике</div></div>
      <div class="fx"><div class="fx-n">2500+</div><div class="fx-l">часов подготовки</div></div>
      <div class="fx"><div class="fx-n">17 лет</div><div class="fx-l">в международном бизнесе</div></div>
      <div class="fx"><div class="fx-n">12 лет</div><div class="fx-l">собственной терапии</div></div>
      <div class="fx"><div class="fx-n">RU · EN</div><div class="fx-l">онлайн и очно в Москве</div></div>
    </div>
  </div>

  <div class="hx-wrap">
    <section class="hx-sec">
      <h2 class="hx-h2">Возможно, это про вас</h2>
      <p class="hx-sub">Четыре истории из практики - без имён и деталей, но вы можете узнать свою:</p>
      <div class="pains">
        <div class="pain"><div class="pain-q">Сложный развод, дети, и новые отношения. Вопросы про близость и сексуальность - и желание наконец изменить жизнь. Она назвала это «семейным кризисом».</div></div>
        <div class="pain"><div class="pain-q">Карьерный потолок, в который он упирался годами. Стресс и конфликты. Оказалось - дело совсем не в карьере, а в отношениях: с коллегами, начальством, и с собой.</div></div>
        <div class="pain"><div class="pain-q">Близкие отношения, которые не строятся: трудно выносить чужие чувства и различия. Сближение - и сразу бегство. А за близостью - невыносимость.</div></div>
        <div class="pain"><div class="pain-q">Предприниматель с целями, который сам себя ограничивает. Все знает, но не делает. Работали в обе стороны: коучинг - на движение, терапия - на препятствия.</div></div>
      </div>
    </section>

    <section class="hx-sec">
      <h2 class="hx-h2">Полный список того, с чем я работаю</h2>
      <div class="wk" style="max-width: 720px;">
        <details>
          <summary><span class="wk-t">Выгорание и хронический стресс</span></summary>
          <div class="wk-body">Отпуск был. Не помогло. Снаружи всё держится, внутри давно тихо. Это не лень - это форма жизни стала мала, как старое пальто. Ищем, где именно жмёт.</div>
        </details>
        <details>
          <summary><span class="wk-t">Кризис смысла, экзистенциальная пустота</span></summary>
          <div class="wk-body">Цели достигнуты, радости ноль. В три часа ночи приходит «зачем всё это» - и тишина в ответ. Новый смысл я не выдаю. Помогаю услышать, чего хотите вы сами.</div>
        </details>
        <details>
          <summary><span class="wk-t">Развод, расставание, восстановление после разрыва</span></summary>
          <div class="wk-body">Злость, вина, облегчение, горе - всё разом, и всё будто «неправильное». Знаю, как это - собирать себя заново. Не прежнего. Другого.</div>
        </details>
        <details>
          <summary><span class="wk-t">Жизнь эмигранта: идентичность, адаптация, одиночество</span></summary>
          <div class="wk-body">Дом остался там, а ты тут. Язык чужой, статус обнулился, друзья в мессенджере. «Кто я теперь» - вопрос совсем не риторический.</div>
        </details>
        <details>
          <summary><span class="wk-t">Трудности в отношениях, повторяющиеся сценарии</span></summary>
          <div class="wk-body">Партнёры меняются, сценарий тот же. Сближение - бегство. Обида - молчание. Смотрим не на «него» или «неё», а на то, как вы строите контакт.</div>
        </details>
        <details>
          <summary><span class="wk-t">Одиночество руководителя, давление ответственности</span></summary>
          <div class="wk-body">Команде не пожалуешься - ты опора. Наверх нельзя - там оценивают. Час в неделю, где можно не быть сильным. Я 17 лет прожил в этой роли.</div>
        </details>
        <details>
          <summary><span class="wk-t">Карьерные переходы: из корпората в своё дело</span></summary>
          <div class="wk-body">Уйти страшно, остаться тошно. Голова считает риски, тело давно всё решило. Разберёмся, что держит: деньги, страх - или горе по жизни, которую придётся отпустить.</div>
        </details>
        <details>
          <summary><span class="wk-t">Мужской опыт: уязвимость, агрессия, самоценность</span></summary>
          <div class="wk-body">Злость, которую некуда деть. Слабость, которую нельзя показать. Здесь можно злиться, плакать и молчать. По-настоящему. Без стыда.</div>
        </details>
      </div>
    </section>

    <section class="hx-sec">
      <h2 class="hx-h2">Почему со мной можно про это</h2>
      <p class="hx-sub">Я держу два мира сразу - и оба знаю не по учебнику.</p>
      <div class="two">
        <div class="two-col">
          <h3>Глубина терапевта</h3>
          <p>Гештальт-терапевт с психоаналитическим мышлением. Магистр психологии ВШЭ, 4-летняя программа МГИ, 2500+ часов учебы.</p>
          <p>12 лет собственной терапии, больше 1000 часов. За эти годы я прожил свои кризисы и принял несколько очень трудных решений - поэтому слышу то, о чём обычно молчат.</p>
        </div>
        <div class="two-col">
          <h3>Опыт в бизнесе</h3>
          <p>До практики - 17 лет в международном бизнесе: Abbott, BMW, Bosch, команды до 300 человек в 30 странах.</p>
          <p>Это не значит, что я работаю только с бизнесом. Это значит, что давление, ответственность и цену решений я знаю изнутри - в какой бы форме они ни пришли к вам.</p>
        </div>
      </div>
    </section>

    <section class="hx-sec">
      <h2 class="hx-h2">С чего начинается работа</h2>
      <p class="hx-sub">Без обязательств и «пакетов». Один честный шаг за раз.</p>
      <div class="steps">
        <div class="step">
          <div class="step-n">01</div>
          <div class="step-b"><h4>Написать мне</h4><p>Договориться о времени, задать вопросы - или созвониться на 15 минут, познакомиться.</p></div>
        </div>
        <div class="step">
          <div class="step-n">02</div>
          <div class="step-b"><h4>Первая сессия</h4><p>Знакомимся, разбираемся в запросе - даже если он ещё не сформулирован - и начинаем работать.</p></div>
        </div>
        <div class="step">
          <div class="step-n">03</div>
          <div class="step-b"><h4>Регулярная работа</h4><p>Обычно раз в неделю. Темп и глубину выбираем вместе и регулярно сверяемся, туда ли идём.</p></div>
        </div>
      </div>
    </section>

    <section class="hx-sec">
      <h2 class="hx-h2">Форматы работы</h2>
      <p class="hx-sub">Не знаете, что подойдёт, - начните с бесплатной встречи, разберёмся вместе.</p>
      <div class="fmts">
        <a class="fmt lead-fmt" href="/therapy/">
          <div class="fmt-tag">Основной формат</div>
          <div class="fmt-t">Индивидуальная терапия</div>
          <div class="fmt-d">Кризисы, переходы, глубокая личная работа. 50 минут, раз в неделю, онлайн или очно в Москве.</div>
          <div class="fmt-price">5000 ₽ / 60 € за сессию</div>
        </a>
        <a class="fmt" href="/groups/">
          <div class="fmt-tag">Набор открыт</div>
          <div class="fmt-t">Терапевтические группы</div>
          <div class="fmt-d">Увидеть свои способы быть с людьми вживую. «Вернуться в контакт» на русском и «Work, People, Ambition» на английском.</div>
          <div class="fmt-price">от 3000 ₽ за встречу</div>
        </a>
        <a class="fmt" href="/soprovozhdenie/">
          <div class="fmt-tag">Интенсивный формат</div>
          <div class="fmt-t">Сопровождение</div>
          <div class="fmt-d">Executive-коучинг с терапевтической глубиной: движемся к вашим целям и разбираем то, что останавливает.</div>
          <div class="fmt-price">25 000 ₽ в месяц · вход через диагностику</div>
        </a>
      </div>
      <p style="margin-top: 16px; font-size: 14px;"><a href="/format/" style="color: var(--gold); text-decoration: none;">Как выбрать формат →</a></p>
    </section>

    <section class="hx-sec">
      <h2 class="hx-h2">Живой человек, а не функция</h2>
      <div class="human">
        <img src="/images/photo/home-life.jpg" alt="Валерий на Камино-де-Сантьяго" loading="lazy" />
        <div class="prose">
          <p>У меня двое детей и три гитары. Я прошёл Камино-де-Сантьяго, поднимался на Эльбрус, купался в Ганге. Коллеги говорят, что я «больше папа, чем мама» и похож на морячка.</p>
          <p>Я не решаю свои проблемы за счёт клиента и не изображаю невозмутимого эксперта. В кабинете - обычный живой человек, который сам прошёл через многое из того, с чем к нему приходят.</p>
          <p>Пишу канал «Валера. Вслух» - про злость, тело, желание и жизненные радости. Играю блюз. Люблю дорогу и не люблю умные слова, за которыми пусто.</p>
          <p><a href="/about/">Обо мне подробнее</a> · <a href="/business/">опыт в бизнесе</a> · <a href="/credentials/">образование</a></p>
        </div>
      </div>
    </section>

    {posts.length > 0 && (
      <section class="hx-sec">
        <h2 class="hx-h2">Как я думаю - в текстах</h2>
        <p class="hx-sub">Про выгорание, кризисы и живость. Без советов и мотивационных сказок.</p>
        <div class="tag-row" style="margin-bottom: 24px;">
          <a href="/blog/" class="tag-chip active">Все</a>
          {tags.map((tag) => (<a href={`/blog/tag/${tag}/`} class="tag-chip"> #{tag}</a>))}
        </div>
        <div class="posts3">
          {posts.map((p) => (
            <a class="post-card" href={`/blog/${p.id.replace(/^ru\//, '')}/`}>
              {p.data.cover && <img src={p.data.cover} alt={p.data.title} style="width: 100%; aspect-ratio: 3/2; object-fit: cover; border-radius: 8px; margin-bottom: 12px;" loading="lazy" />}
              <div class="post-date">{fmt(p.data.date)}</div>
              <div class="post-title">{p.data.title}</div>
            </a>
          ))}
        </div>
        <p style="margin-top: 24px;"><a href="/blog/" class="tag-chip">Показать еще →</a></p>
      </section>
    )}

    <!-- «Правки-6» п.12: дополнительный воздух перед блоком -->
    <section class="hx-sec hx-sec-gap">
      <h2 class="hx-h2">Где еще я пишу</h2>
      <div class="grid-2">
        <a class="write-card" href="/blog/">
          <img src="/images/photo/cover-sobaka.jpg" alt="Блог" />
          <div>
            <div class="write-title">Избранные статьи на этом сайте</div>
            <div class="write-desc">Выгорание, кризисы, терапия без ботвы</div>
          </div>
        </a>
        <a class="write-card" href="https://t.me/valera_outloud">
          <img src="/images/photo/valera-vsluh.jpg" alt="Валера. Вслух" />
          <div>
            <div class="write-title">Телеграм-канал «Валера. Вслух»</div>
            <div class="write-desc">Про злость, тело, желание, стыд и жизненные радости</div>
          </div>
        </a>
        <a class="write-card" href="https://dzen.ru/valera_toptop">
          <img src="/images/photo/cover-backpack.jpg" alt="Топ-топ" />
          <div>
            <div class="write-title">Блог о дороге «Топ-топ»</div>
            <div class="write-desc">Camino, дороги, города и внутренние переходы</div>
          </div>
        </a>
        <a class="write-card" href="https://www.b17.ru/karasaev/#article">
          <img src="/images/photo/about-today.jpg" alt="B17" />
          <div>
            <div class="write-title">Статьи о психологии на B17</div>
            <div class="write-desc">Кейсы, разборы теории и практики</div>
          </div>
        </a>
      </div>
      <SocIcons ids={['instagram', 'youtube', 'facebook','linkedin', 'vk']} />
    </section>
  </div>

  <section class="hx-cta-final-wrap">
    <div class="cta-final">
      <!-- «Правки-6» п.11: CTA приглашает к контакту, а не продвигает один
           сценарий. Основная кнопка - просто «написать», варианты - в подписи. -->
      <div class="cta-title">Первый шаг - просто написать</div>
      <div class="cta-sub">Задать вопрос, договориться о бесплатном 15-минутном созвоне - или записаться на сессию. Как удобнее</div>
      <div class="btn-group" style="margin: 0;">
        <a href={site.telegram} class="btn btn-primary">Написать в Telegram</a>
        <a href={'mailto:' + site.email} class="btn btn-outline">{site.email}</a>
      </div>
    </div>
  </section>

  <footer class="site-footer">
    <div class="site-footer-in">
      <span>Валерий Карасаев · психолог, гештальт-терапевт</span>
      <span><a href={site.telegram}>{site.telegramHandle}</a> · <a href={'mailto:' + site.email}>{site.email}</a> · <a href={site.phoneHref}>{site.phone}</a></span>
      <span><a href="/principles/">Принципы</a> · <a href="/privacy/">Конфиденциальность</a> · <a href="/terms/">Условия</a> · <a href="/sos/">SOS</a></span>
    </div>
  </footer>
</Base>
