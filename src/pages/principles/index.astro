    letter-spacing: 1.35px;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .rules-print:hover {
    color: var(--gold2);
    border-bottom-color: var(--gold2);
  }

  .rules-print:focus-visible,
  .agreement-list summary:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 4px;
  }

  .page-section {
