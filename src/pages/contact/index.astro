---
// /contact/ (T8): все способы связи + куда подписаться. Данные только из site.ts.
import Page from '../../layouts/Page.astro';
import { site } from '../../data/site';
import SocIcons from '../../components/SocIcons.astro';
---

<Page
  title="Контакты · Валерий Карасаев"
  description="Как связаться с Валерием Карасаевым: Telegram, почта, телефон. Запись на сессию и бесплатную 15-минутную встречу. Telegram-канал, B17, Дзен."
  translation="/en/contact/"
>
  <div class="page-head">
    <div class="kicker">Контакты</div>
    <h1 class="page-title">Написать мне - это уже шаг</h1>
    <p class="lead">
      Самый быстрый способ - <a href="https://t.me/vkarasaev" style="color: var(--gold);">Telegram</a>.
      Отвечаю лично, обычно в течение дня. 
      Напишите, если есть вопрос или хотите договориться о встрече.
    </p>
  </div>

  <div class="meta-line"><span class="meta-num">01</span><span class="meta-label">Связь</span></div>
  <div class="spec">
    <div class="spec-row"><span class="spec-key">Telegram</span><span class="spec-val"><a href={site.telegram} style="color: var(--gold); text-decoration: none;">{site.telegramHandle}</a></span></div>
    <div class="spec-row"><span class="spec-key">Почта</span><span class="spec-val"><a href={'mailto:' + site.email} style="color: var(--gold); text-decoration: none;">{site.email}</a></span></div>
    <div class="spec-row"><span class="spec-key">Телефон</span><span class="spec-val"><a href={site.phoneHref} style="color: var(--gold); text-decoration: none;">{site.phone}</a></span></div>
    <div class="spec-row"><span class="spec-key">Расписание сессий</span><span class="spec-val">{site.session.schedule}</span></div>
    <div class="spec-row"><span class="spec-key">Очно</span><span class="spec-val">{site.session.offline}</span></div>
  </div>


  <div class="meta-line"><span class="meta-num">02</span><span class="meta-label">Где проходят очные встречи</span></div>
  <div class="prose">
    <p>
      Принимаю очно в Москве - пространство «Хорошее место»: Волков переулок, дом 4. Это в пяти минутах от м. Краснопресненская. Вход через арку, 1-й подъезд, 2-й этаж.
    </p>
  </div>
 <div style="max-width: 720px; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--border); margin: 0 auto 34px;">
  <iframe src="https://yandex.ru/map-widget/v1/?um=constructor%3Ad1afb52f68b6c0a04a59437ffd053f6a0b9a5ed5e1cc8964fa3c2c950c5a6144&amp;source=constructor" width="100%" height="350" frameborder="0"></iframe>
</div>

  <div class="meta-line"><span class="meta-num">03</span><span class="meta-label">Где меня читать</span></div>
  <div class="grid-2 contact-links">
    <a class="write-card" href="/blog/">
      <img src="/images/photo/cover-sobaka.jpg" alt="Блог" />
      <div>
        <div class="write-title">Избранные статьи на сайте</div>
        <div class="write-desc">Выгорание, кризисы, терапия без ботвы - лучшие тексты собраны в блоге</div>
      </div>
    </a>
    <a class="write-card" href="https://t.me/valera_outloud">
      <img src="/images/photo/avatar.jpg" alt="Валера. Вслух" />
      <div>
        <div class="write-title">Телеграм-канал «Валера. Вслух»</div>
        <div class="write-desc">Про злость, тело, желание, стыд, жадность и жизненные радости</div>
      </div>
    </a>
    <a class="write-card" href="https://dzen.ru/valera_toptop">
      <img src="/images/photo/cover-backpack.jpg" alt="Топ-топ" />
      <div>
        <div class="write-title">Блог о дороге «Топ-топ»</div>
        <div class="write-desc">Camino, дороги, города и внутренние переходы</div>
      </div>
    </a>
    <a class="write-card" href="https://www.b17.ru/karasaev/#article">
      <img src="/images/photo/about-today.jpg" alt="B17" />
      <div>
        <div class="write-title">Статьи о психологии на B17</div>
        <div class="write-desc">Кейсы, разборы теории и практики</div>
      </div>
    </a>
  </div>
  <SocIcons />
</Page>
